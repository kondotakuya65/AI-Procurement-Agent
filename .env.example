# Application
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3001

# API
APP_PORT=8100

# Database
DATABASE_URL=sqlite:///./dev.db
# DATABASE_URL=postgresql+psycopg2://procure:procure@localhost:5432/procurement_agent

# LLM — ollama | openai | anthropic | mock
LLM_PROVIDER=mock
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=phi3:mini
LLM_TIMEOUT_SECONDS=45
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# FinOps-RAG integration — live | mock (live falls back to mock on failure)
FINOPS_MODE=mock
FINOPS_API_URL=http://localhost:8000
FINOPS_TIMEOUT_SECONDS=15
FINOPS_RETRIES=2

# Paths
FIXTURES_DIR=../fixtures
OUTBOX_DIR=./outbox

# Stretch: writer→reviewer rewrite if draft is weak
EMAIL_REFLECTION=true

# Stretch: vendor search — fixtures | live | hybrid
VENDOR_SEARCH_MODE=fixtures
# Optional live offers API: GET ?sku=&quantity= → {"offers":[...]}
VENDOR_LIVE_URL=

# Frontend
API_PROXY_TARGET=http://localhost:8100
